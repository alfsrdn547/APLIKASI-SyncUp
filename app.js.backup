const WORKSPACE_KEY = 'syncup-workspace-state';
const USER_STORE_KEY = 'syncup-users';
const ACTIVE_USER_KEY = 'syncup-active-user';
const API_ENDPOINT = '/api/workspace';

const defaultState = {
  members: [
    { id: crypto.randomUUID(), name: 'Demo Tim', role: 'Project Lead' },
    { id: crypto.randomUUID(), name: 'Rina', role: 'Designer' },
    { id: crypto.randomUUID(), name: 'Budi', role: 'Developer' }
  ],
  tasks: [
    { id: crypto.randomUUID(), title: 'Review sprint backlog', done: true, date: '2026-07-05', priority: 'Tinggi', note: 'Diskusikan prioritas sprint', assignee: 'Demo Tim' },
    { id: crypto.randomUUID(), title: 'Perbarui desain landing page', done: false, date: '2026-07-06', priority: 'Sedang', note: 'Siapkan versi final', assignee: 'Rina' }
  ],
  events: [
    { id: crypto.randomUUID(), title: 'Standup harian', date: '2026-07-05', priority: 'Tinggi', note: 'Update progres tim' },
    { id: crypto.randomUUID(), title: 'Demo fitur baru', date: '2026-07-07', priority: 'Sedang', note: 'Tunjukkan hasil sprint' }
  ],
  notes: [
    'Pastikan dokumen PRD selalu tersedia di workspace.',
    'Bagi tanggung jawab secara jelas sebelum rapat.'
  ]
};

function cloneState(source) {
  return JSON.parse(JSON.stringify(source));
}

function normalizeTask(task) {
  const status = task.status || (task.done ? 'done' : 'backlog');
  return {
    ...task,
    done: status === 'done',
    status
  };
}

function normalizeState(source) {
  const normalized = cloneState(source || {});
  normalized.members = normalized.members || [];
  normalized.events = normalized.events || [];
  normalized.notes = normalized.notes || [];
  normalized.tasks = (normalized.tasks || []).map(normalizeTask);
  return normalized;
}

function createDefaultState() {
  return normalizeState(defaultState);
}

function loadUsers() {
  const saved = localStorage.getItem(USER_STORE_KEY);
  if (!saved) {
    const demoUser = {
      id: crypto.randomUUID(),
      name: 'Demo Tim',
      email: 'demo@syncup.id',
      password: '123456'
    };
    localStorage.setItem(USER_STORE_KEY, JSON.stringify([demoUser]));
    return [demoUser];
  }
  return JSON.parse(saved);
}

function saveUsers() {
  localStorage.setItem(USER_STORE_KEY, JSON.stringify(users));
}

function loadWorkspaceState() {
  const saved = localStorage.getItem(WORKSPACE_KEY);
  return saved ? normalizeState(JSON.parse(saved)) : createDefaultState();
}

function saveWorkspaceState() {
  localStorage.setItem(WORKSPACE_KEY, JSON.stringify(state));
}

function getCurrentUser() {
  return users.find((user) => user.id === activeUserId) || null;
}

let users = loadUsers();
let activeUserId = localStorage.getItem(ACTIVE_USER_KEY);
let state = loadWorkspaceState();

const authScreen = document.getElementById('authScreen');
const appShell = document.getElementById('appShell');
const loginForm = document.getElementById('loginForm');
const registerForm = document.getElementById('registerForm');
const authMessage = document.getElementById('authMessage');
const authTabs = document.querySelectorAll('.auth-tab');
const form = document.getElementById('itemForm');
const backlogList = document.getElementById('backlogList');
const ongoingList = document.getElementById('ongoingList');
const doneList = document.getElementById('doneList');
const eventsList = document.getElementById('eventsList');
const notesList = document.getElementById('notesList');
const todayCount = document.getElementById('todayCount');
const doneCount = document.getElementById('doneCount');
const memberCount = document.getElementById('memberCount');
const progressBar = document.getElementById('progressBar');
const progressText = document.getElementById('progressText');
const currentUserName = document.getElementById('currentUserName');
const logoutBtn = document.getElementById('logoutBtn');
const themeToggle = document.getElementById('themeToggle');
const completionRate = document.getElementById('completionRate');
const weekEvents = document.getElementById('weekEvents');
const activeNotes = document.getElementById('activeNotes');
const deadlineList = document.getElementById('deadlineList');
const exportBtn = document.getElementById('exportBtn');
const form = document.getElementById('itemForm');
const assigneeSelect = document.getElementById('assignee');
const attachmentInput = document.getElementById('attachment');

// Agenda Page Elements
const agendaForm = document.getElementById('agendaForm');
const agendaTitleInput = document.getElementById('agendaTitle');
const agendaDateInput = document.getElementById('agendaDate');
const agendaPriorityInput = document.getElementById('agendaPriority');
const agendaNoteInput = document.getElementById('agendaNote');
const agendaCalendarDate = document.getElementById('agendaCalendarDate');
const agendaPriorityFilter = document.getElementById('agendaPriorityFilter');
const agendaEventsList = document.getElementById('agendaEventsList');

// Kanban Page Elements
const kanbanTaskForm = document.getElementById('kanbanTaskForm');
const kanbanTitleInput = document.getElementById('kanbanTitle');
const kanbanDateInput = document.getElementById('kanbanDate');
const kanbanPriorityInput = document.getElementById('kanbanPriority');
const kanbanAssigneeInput = document.getElementById('kanbanAssignee');
const kanbanNoteInput = document.getElementById('kanbanNote');
const kanbanAttachmentInput = document.getElementById('kanbanAttachment');
const kanbanTaskSearch = document.getElementById('kanbanTaskSearch');
const kanbanTaskFilter = document.getElementById('kanbanTaskFilter');
const kanbanBacklogList = document.getElementById('kanbanBacklogList');
const kanbanOngoingList = document.getElementById('kanbanOngoingList');
const kanbanDoneList = document.getElementById('kanbanDoneList');

// Notes Page Elements
const notesPageForm = document.getElementById('notesPageForm');
const notesPageInput = document.getElementById('notesPageInput');
const notesPageList = document.getElementById('notesPageList');
const notesCountText = document.getElementById('notesCountText');

// Navigation Elements
const navLinks = document.querySelectorAll('.nav-link');
const pages = document.querySelectorAll('.page');

const ATTACHMENT_DIR = 'uploads';

function showAuthMessage(message, isError = false) {
  authMessage.textContent = message;
  authMessage.style.color = isError ? '#dc2626' : '#3861fb';
}

function updateAuthView() {
  const loggedIn = Boolean(activeUserId && getCurrentUser());
  authScreen.classList.toggle('hidden', loggedIn);
  appShell.classList.toggle('hidden', !loggedIn);

  if (loggedIn) {
    currentUserName.textContent = getCurrentUser().name;
  }
}

function navigateToPage(pageName) {
  pages.forEach(page => page.classList.add('hidden'));
  const targetPage = document.getElementById(pageName + 'Page');
  if (targetPage) targetPage.classList.remove('hidden');
  
  navLinks.forEach(link => link.classList.remove('active'));
  const targetLink = document.querySelector(`[data-page="${pageName}"]`);
  if (targetLink) targetLink.classList.add('active');
  
  if (pageName === 'kanban') {
    renderKanbanPage();
  } else if (pageName === 'agenda') {
    renderAgendaPage();
  } else if (pageName === 'notes') {
    renderNotesPage();
  } else if (pageName === 'dashboard') {
    render();
  }
}

function resetState() {
  state = loadWorkspaceState();
}

function render() {
  renderStats();
  renderDeadlines();
  renderNotes();
  renderMembers();
}
  renderEvents();
  renderNotes();
  renderMembers();
}

function renderKanbanPage() {
  renderKanbanTasks();
}

function renderAgendaPage() {
  renderAgendaEvents();
}

function renderNotesPage() {
  const notesText = (state.notes || []).length > 0 ? `${state.notes.length} catatan` : '0 catatan';
  notesCountText.textContent = notesText;
  notesPageList.innerHTML = '';
  if (!state.notes || state.notes.length === 0) {
    notesPageList.innerHTML = '<p>Belum ada catatan. Mulai dengan menambahkan catatan baru.</p>';
    return;
  }
  state.notes.forEach((note, index) => {
    const div = document.createElement('div');
    div.className = 'note-item';
    div.innerHTML = `
      <div>${note}</div>
      <button class="badge" data-action="delete-note" data-index="${index}" style="background:#fee;color:#c00;width:100%;">Hapus</button>
    `;
    notesPageList.appendChild(div);
  });
}

function renderAgendaEvents() {
  agendaEventsList.innerHTML = '';
  const selectedDate = agendaCalendarDate.value || new Date().toISOString().split('T')[0];
  const selectedPriority = agendaPriorityFilter.value;
  const filtered = state.events.filter((event) => {
    const matchDate = !selectedDate || event.date === selectedDate;
    const matchPriority = selectedPriority === 'all' || event.priority === selectedPriority;
    return matchDate && matchPriority;
  });

  if (filtered.length === 0) {
    agendaEventsList.innerHTML = '<p>Belum ada agenda sesuai filter.</p>';
    return;
  }
  filtered.forEach((event) => {
    const item = document.createElement('div');
    item.className = 'list-item';
    item.innerHTML = `
      <div>
        <strong>${event.title}</strong>
        <div class="task-meta">${event.date} • ${event.priority}</div>
        <small>${event.note}</small>
      </div>
      <button class="badge" data-action="delete-event" data-id="${event.id}" style="width:100%;background:#fee;color:#c00;">Hapus</button>
    `;
    agendaEventsList.appendChild(item);
  });
}

function renderKanbanTasks() {
  const searchText = (kanbanTaskSearch.value || '').toLowerCase();
  const filterStatus = kanbanTaskFilter.value;
  const tasks = state.tasks || [];
  
  const filtered = tasks.filter((task) => {
    const matchSearch = !searchText || task.title.toLowerCase().includes(searchText);
    const matchFilter = filterStatus === 'all' || (filterStatus === 'pending' && !task.done) || (filterStatus === 'done' && task.done);
    return matchSearch && matchFilter;
  });
  
  const backlogTasks = filtered.filter((task) => getTaskStatus(task) === 'backlog');
  const ongoingTasks = filtered.filter((task) => getTaskStatus(task) === 'ongoing');
  const doneTasks = filtered.filter((task) => getTaskStatus(task) === 'done');
  
  renderKanbanColumn(kanbanBacklogList, backlogTasks);
  renderKanbanColumn(kanbanOngoingList, ongoingTasks);
  renderKanbanColumn(kanbanDoneList, doneTasks);
}

function renderKanbanColumn(targetList, tasks) {
  targetList.innerHTML = '';
  if (tasks.length === 0) {
    targetList.innerHTML = '<p>Tidak ada tugas</p>';
    return;
  }
  
  tasks.forEach((task) => {
    const item = document.createElement('div');
    item.className = `list-item kanban-card ${task.done ? 'done' : ''}`;
    item.draggable = true;
    item.dataset.taskId = task.id;
    const priorityColor = task.priority === 'Tinggi' ? '#ef4444' : task.priority === 'Sedang' ? '#f59e0b' : '#10b981';
    item.innerHTML = `
      <div>
        <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
          <strong>${task.title}</strong>
          <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:${priorityColor}; flex-shrink:0;" title="${task.priority}"></span>
        </div>
        <div class="task-meta">${task.date} • ${task.priority}</div>
        <small>${task.note}</small>
        <div>👤 ${task.assignee || 'Belum ditugaskan'}</div>
        ${task.attachment ? getAttachmentLink(task.attachment) : ''}
      </div>
      <div style="display:flex; gap:6px; flex-direction:column; align-items:stretch;">
        ${getTaskStatus(task) !== 'done' ? `<button class="badge" data-action="move-done" data-id="${task.id}" style="width:100%;background:#10b981;color:white;">✓ Selesai</button>` : ''}
        <button class="badge" data-action="toggle-task" data-id="${task.id}" style="width:100%;">${task.done ? '✓ Selesai' : '⭐ Pending'}</button>
        <button class="badge" data-action="delete-task" data-id="${task.id}" style="width:100%;background:#fee;color:#c00;">Hapus</button>
      </div>
    `;
    targetList.appendChild(item);
  });
}
  populateAssigneeOptions();
}

function renderDeadlines() {
  const now = new Date();
  const upcoming = state.tasks
    .filter((task) => !task.done && task.date)
    .map((task) => {
      const dueDate = new Date(task.date);
      const diffDays = Math.ceil((dueDate - now) / (1000 * 60 * 60 * 24));
      return { ...task, diffDays };
    })
    .filter((task) => task.diffDays >= 0)
    .sort((a, b) => a.diffDays - b.diffDays)
    .slice(0, 3);

  deadlineList.innerHTML = '';

  if (!upcoming.length) {
    deadlineList.innerHTML = '<p>Belum ada deadline yang mendekati.</p>';
    return;
  }

  upcoming.forEach((task) => {
    const item = document.createElement('div');
    item.className = `deadline-item ${task.diffDays <= 2 ? 'urgent' : ''}`;
    item.innerHTML = `
      <div>
        <strong>${task.title}</strong>
        <small>${task.date} • ${task.priority}</small>
      </div>
      <span>${task.diffDays === 0 ? 'Hari ini' : `${task.diffDays} hari`}</span>
    `;
    deadlineList.appendChild(item);
  });
}

function renderStats() {
  const today = new Date().toISOString().split('T')[0];
  const todayEvents = state.events.filter((event) => event.date === today).length;
  const completedTasks = state.tasks.filter((task) => task.done).length;
  const progress = state.tasks.length ? Math.round((completedTasks / state.tasks.length) * 100) : 0;
  const todayDate = new Date();
  const weekStart = new Date(todayDate);
  weekStart.setDate(todayDate.getDate() - todayDate.getDay());
  const weekEnd = new Date(weekStart);
  weekEnd.setDate(weekStart.getDate() + 6);
  const weekEventsCount = state.events.filter((event) => {
    const eventDate = new Date(event.date);
    return eventDate >= weekStart && eventDate <= weekEnd;
  }).length;

  todayCount.textContent = todayEvents;
  doneCount.textContent = `${completedTasks}/${state.tasks.length}`;
  memberCount.textContent = state.members?.length || 0;
  progressBar.textContent = `${progress}%`;
  progressText.textContent = `${completedTasks} dari ${state.tasks.length} tugas selesai, fokus utama: ${state.tasks.find((task) => !task.done)?.title || 'Semua selesai'}`;
  completionRate.textContent = `${progress}%`;
  weekEvents.textContent = weekEventsCount;
  activeNotes.textContent = state.notes?.length || 0;
}

function getFilteredTasks() {
  const search = taskSearch.value.trim().toLowerCase();
  const filter = taskFilter.value;

  return state.tasks.filter((task) => {
    const matchesSearch = !search || task.title.toLowerCase().includes(search) || task.note.toLowerCase().includes(search);
    const matchesFilter = filter === 'all' || (filter === 'pending' && !task.done) || (filter === 'done' && task.done);
    return matchesSearch && matchesFilter;
  });
}

function getAllTasksForKanban() {
  return state.tasks || [];
}

function getAttachmentLink(attachment) {
  if (!attachment) return '';
  return `<div>Lampiran: <a href="/${ATTACHMENT_DIR}/${attachment}" target="_blank" rel="noreferrer">${attachment}</a></div>`;
}

function getTaskStatus(task) {
  return task.status || (task.done ? 'done' : 'backlog');
}

function renderTasks() {
  backlogList.innerHTML = '';
  ongoingList.innerHTML = '';
  doneList.innerHTML = '';

  const allTasks = getAllTasksForKanban();
  const backlogTasks = allTasks.filter(t => getTaskStatus(t) === 'backlog');
  const ongoingTasks = allTasks.filter(t => getTaskStatus(t) === 'ongoing');
  const doneTasks = allTasks.filter(t => getTaskStatus(t) === 'done');

  if (!allTasks.length) {
    backlogList.innerHTML = '<p>Tidak ada tugas</p>';
    ongoingList.innerHTML = '<p>Tidak ada tugas</p>';
    doneList.innerHTML = '<p>Tidak ada tugas</p>';
    return;
  }

  const renderTaskToColumn = (tasks, targetList) => {
    if (!tasks.length) {
      targetList.innerHTML = '<p>Kosong</p>';
      return;
    }

    tasks.forEach((task) => {
      const item = document.createElement('div');
      item.className = `list-item kanban-card ${task.done ? 'done' : ''}`;
      item.draggable = true;
      item.dataset.taskId = task.id;
      const priorityColor = task.priority === 'Tinggi' ? '#ef4444' : task.priority === 'Sedang' ? '#f59e0b' : '#10b981';
      item.innerHTML = `
        <div>
          <div style="display:flex; gap:8px; align-items:center; margin-bottom:6px;">
            <strong>${task.title}</strong>
            <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:${priorityColor}; flex-shrink:0;" title="${task.priority}"></span>
          </div>
          <div class="task-meta">${task.date} • ${task.priority}</div>
          <small>${task.note}</small>
          <div>👤 ${task.assignee || 'Belum ditugaskan'}</div>
          ${task.attachment ? getAttachmentLink(task.attachment) : ''}
        </div>
        <div style="display:flex; gap:6px; flex-direction:column; align-items:stretch;">
          ${getTaskStatus(task) !== 'done' ? `<button class="badge" data-action="move-done" data-id="${task.id}" style="width:100%;background:#10b981;color:white;">✓ Selesai</button>` : ''}
          <button class="badge" data-action="toggle-task" data-id="${task.id}" style="width:100%;">${task.done ? '✓ Selesai' : '⭐ Pending'}</button>
          <button class="badge" data-action="delete-task" data-id="${task.id}" style="width:100%;background:#fee;color:#c00;">Hapus</button>
        </div>
      `;
      targetList.appendChild(item);
    });
  };

  renderTaskToColumn(backlogTasks, backlogList);
  renderTaskToColumn(ongoingTasks, ongoingList);
  renderTaskToColumn(doneTasks, doneList);
}

function renderEvents() {
  eventsList.innerHTML = '';
  const selectedDate = calendarDate.value;
  const selectedPriority = priorityFilter.value;
  const filteredEvents = state.events.filter((event) => {
    const matchesDate = !selectedDate || event.date === selectedDate;
    const matchesPriority = selectedPriority === 'all' || event.priority === selectedPriority;
    return matchesDate && matchesPriority;
  });

  if (!filteredEvents.length) {
    eventsList.innerHTML = '<p>Belum ada agenda sesuai filter.</p>';
    return;
  }

  filteredEvents.forEach((event) => {
    const item = document.createElement('div');
    item.className = 'list-item';
    item.innerHTML = `
      <div>
        <strong>${event.title}</strong>
        <div>${event.date} • ${event.priority}</div>
        <small>${event.note}</small>
      </div>
      <button class="badge" data-action="delete-event" data-id="${event.id}">Hapus</button>
    `;
    eventsList.appendChild(item);
  });
}

function renderNotes() {
  notesList.innerHTML = '';

  state.notes.forEach((note, index) => {
    const card = document.createElement('div');
    card.className = 'note-card';
    card.innerHTML = `
      <span>${note}</span>
      <button data-action="delete-note" data-index="${index}">Hapus</button>
    `;
    notesList.appendChild(card);
  });
}

function renderMembers() {
  membersList.innerHTML = '';

  if (!state.members?.length) {
    membersList.innerHTML = '<p>Belum ada anggota tim.</p>';
    return;
  }

  state.members.forEach((member) => {
    const card = document.createElement('div');
    card.className = 'member-card';
    card.innerHTML = `
      <strong>${member.name}</strong>
      <div>${member.role}</div>
    `;
    membersList.appendChild(card);
  });
}

function populateAssigneeOptions() {
  assigneeSelect.innerHTML = '';
  const defaultOption = document.createElement('option');
  defaultOption.value = 'Semua';
  defaultOption.textContent = 'Semua';
  assigneeSelect.appendChild(defaultOption);

  (state.members || []).forEach((member) => {
    const option = document.createElement('option');
    option.value = member.name;
    option.textContent = member.name;
    assigneeSelect.appendChild(option);
  });
}

async function persistWorkspace() {
  saveWorkspaceState();
  saveUsers();

  try {
    await fetch(API_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ users, activeUserId, state })
    });
  } catch (error) {
    console.warn('Gagal menyimpan ke server lokal:', error);
  }
}

async function loadRemoteWorkspace() {
  try {
    const response = await fetch(API_ENDPOINT, { headers: { Accept: 'application/json' } });
    if (!response.ok) {
      throw new Error('Server tidak merespons');
    }

    const payload = await response.json();
    if (payload?.users?.length) {
      users = payload.users;
      activeUserId = payload.activeUserId || null;
      state = normalizeState(payload.state || createDefaultState());
      saveUsers();
      saveWorkspaceState();
      localStorage.setItem(ACTIVE_USER_KEY, activeUserId || '');
    }
  } catch (error) {
    console.warn('Menggunakan data lokal karena server belum siap:', error);
  }
}

function saveState() {
  saveWorkspaceState();
  saveUsers();
  void persistWorkspace();
}

loginForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  const email = document.getElementById('loginEmail').value.trim().toLowerCase();
  const password = document.getElementById('loginPassword').value;
  const matchedUser = users.find((user) => user.email.toLowerCase() === email);

  if (!matchedUser) {
    showAuthMessage('Akun tidak ditemukan. Silakan daftar terlebih dahulu.', true);
    return;
  }

  if (matchedUser.password !== password) {
    showAuthMessage('Password salah. Silakan cek kembali.', true);
    return;
  }

  activeUserId = matchedUser.id;
  localStorage.setItem(ACTIVE_USER_KEY, activeUserId);
  state = loadWorkspaceState();
  await persistWorkspace();
  updateAuthView();
  render();
  loginForm.reset();
  showAuthMessage('Berhasil masuk ke workspace.');
});

registerForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  const name = document.getElementById('registerName').value.trim();
  const email = document.getElementById('registerEmail').value.trim().toLowerCase();
  const password = document.getElementById('registerPassword').value;
  const confirm = document.getElementById('registerConfirm').value;

  if (password.length < 6) {
    showAuthMessage('Password minimal 6 karakter.', true);
    return;
  }

  if (password !== confirm) {
    showAuthMessage('Konfirmasi password tidak cocok.', true);
    return;
  }

  if (users.some((user) => user.email.toLowerCase() === email)) {
    showAuthMessage('Email sudah terdaftar. Silakan gunakan email lain.', true);
    return;
  }

  const newUser = {
    id: crypto.randomUUID(),
    name,
    email,
    password,
    ...createDefaultState()
  };

  users.push(newUser);
  saveUsers();
  activeUserId = newUser.id;
  localStorage.setItem(ACTIVE_USER_KEY, activeUserId);
  state = loadWorkspaceState();
  await persistWorkspace();
  updateAuthView();
  render();
  registerForm.reset();
  showAuthMessage(`Akun ${name} berhasil dibuat.`);
});

authTabs.forEach((tab) => {
  tab.addEventListener('click', () => {
    authTabs.forEach((item) => item.classList.remove('active'));
    tab.classList.add('active');
    const target = tab.dataset.authTab;
    loginForm.classList.toggle('hidden', target === 'register');
    registerForm.classList.toggle('hidden', target === 'login');
  });
});

form.addEventListener('submit', async (event) => {
  event.preventDefault();

  const file = attachmentInput.files && attachmentInput.files[0] ? attachmentInput.files[0] : null;
  let attachmentName = '';

  if (file) {
    const formData = new FormData();
    formData.append('file', file);
    const response = await fetch('/api/upload', {
      method: 'POST',
      body: formData
    });
    const result = await response.json();
    attachmentName = result.filename || '';
  }

  const payload = {
    id: crypto.randomUUID(),
    title: document.getElementById('title').value.trim(),
    type: document.getElementById('type').value,
    date: document.getElementById('date').value,
    priority: document.getElementById('priority').value,
    assignee: assigneeSelect.value,
    attachment: attachmentName,
    note: document.getElementById('note').value.trim(),
    status: 'backlog'
  };

  if (!payload.title || !payload.date) {
    return;
  }

  if (payload.type === 'task') {
    state.tasks.unshift({ ...payload, done: false });
  } else {
    state.events.unshift({ ...payload });
  }

  saveState();
  render();
  form.reset();
});

exportBtn.addEventListener('click', () => {
  const content = [
    'SyncUp Workspace Export',
    `- Total tugas: ${state.tasks.length}`,
    `- Tugas selesai: ${state.tasks.filter((task) => task.done).length}`,
    `- Anggota tim: ${state.members.length}`,
    '',
    'Daftar tugas:',
    ...state.tasks.map((task) => `• ${task.title} [${task.done ? 'Selesai' : 'Belum selesai'}] - ${task.assignee || 'Belum ditugaskan'}`),
    '',
    'Catatan:',
    ...state.notes
  ].join('\n');

  const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const link = document.createElement('a');
  link.href = url;
  link.download = 'syncup-export.txt';
  link.click();
  URL.revokeObjectURL(url);
});

toggleForm.addEventListener('click', () => {
  document.getElementById('title').focus();
});

taskSearch.addEventListener('input', renderTasks);
taskFilter.addEventListener('change', renderTasks);
calendarDate.addEventListener('change', renderEvents);
priorityFilter.addEventListener('change', renderEvents);

noteForm.addEventListener('submit', (event) => {
  event.preventDefault();
  const value = noteInput.value.trim();
  if (!value) return;

  state.notes.unshift(value);
  noteInput.value = '';
  saveState();
  renderNotes();
});

memberForm.addEventListener('submit', (event) => {
  event.preventDefault();
  const name = memberNameInput.value.trim();
  const role = memberRoleInput.value.trim();

  if (!name || !role) return;

  state.members.push({ id: crypto.randomUUID(), name, role });
  memberNameInput.value = '';
  memberRoleInput.value = '';
  saveState();
  render();
});

logoutBtn.addEventListener('click', async () => {
  localStorage.removeItem(ACTIVE_USER_KEY);
  activeUserId = null;
  resetState();
  await persistWorkspace();
  updateAuthView();
  showAuthMessage('Anda telah keluar. Silakan masuk kembali.');
});

themeToggle.addEventListener('click', () => {
  document.body.classList.toggle('dark-theme');
  const isDark = document.body.classList.contains('dark-theme');
  themeToggle.textContent = isDark ? '☀️ Terang' : '🌙 Gelap';
  localStorage.setItem('syncup-theme', isDark ? 'dark' : 'light');
});

document.addEventListener('dragstart', (event) => {
  const item = event.target.closest('.list-item');
  if (!item) return;
  event.dataTransfer.setData('text/plain', item.dataset.taskId || '');
});

document.addEventListener('dragover', (event) => {
  const column = event.target.closest('.kanban-column');
  if (!column) return;
  event.preventDefault();
});

document.addEventListener('drop', (event) => {
  const column = event.target.closest('.kanban-column');
  const taskId = event.dataTransfer.getData('text/plain');
  if (!column || !taskId) return;
  event.preventDefault();

  const status = column.dataset.status;
  const nextStatus = status === 'done' ? 'done' : status === 'ongoing' ? 'ongoing' : 'backlog';
  state.tasks = state.tasks.map((task) => {
    if (task.id !== taskId) return task;
    return {
      ...task,
      done: nextStatus === 'done',
      status: nextStatus
    };
  });

  saveState();
  render();
});

document.addEventListener('click', (event) => {
  const button = event.target.closest('button');
  if (!button) return;

  const { action, id, index } = button.dataset;
  if (!action) return;

  if (action === 'toggle-task') {
    if (!id) return;
    state.tasks = state.tasks.map((task) => {
      if (task.id !== id) return task;
      const nextDone = !task.done;
      return {
        ...task,
        done: nextDone,
        status: nextDone ? 'done' : 'ongoing'
      };
    });
  }

  if (action === 'move-done') {
    if (!id) return;
    state.tasks = state.tasks.map((task) => {
      if (task.id !== id) return task;
      return {
        ...task,
        done: true,
        status: 'done'
      };
    });
  }

  if (action === 'delete-task') {
    if (!id) return;
    state.tasks = state.tasks.filter((task) => task.id !== id);
  }

  if (action === 'delete-event') {
    if (!id) return;
    state.events = state.events.filter((event) => event.id !== id);
  }

  if (action === 'delete-note') {
    const noteIndex = Number(index);
    if (Number.isNaN(noteIndex)) return;
    state.notes.splice(noteIndex, 1);
  }

  saveState();
  render();
});

async function initializeApp() {
  await loadRemoteWorkspace();
  const savedTheme = localStorage.getItem('syncup-theme');
  if (savedTheme === 'dark') {
    document.body.classList.add('dark-theme');
    themeToggle.textContent = '☀️ Terang';
  }
  const today = new Date().toISOString().split('T')[0];
  calendarDate.value = today;
  updateAuthView();
  render();
}

initializeApp();
